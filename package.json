{
  "name": "lifeos",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @lifeos/backend dev & pnpm --filter @lifeos/frontend dev",
    "check": "biome check .",
