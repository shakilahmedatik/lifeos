  ],

  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@libsql/client": "^0.17.4",
    "@libsql/core": "^0.17.4"
  }
}
