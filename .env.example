# LifeOS Environment Configuration

# Backend API server port (Local Node.js)
BACKEND_PORT=3000

# Frontend Vite dev server port
FRONTEND_PORT=5173

# Remote Database (Turso libSQL) - REQUIRED for Vercel Serverless & Cloud Sync
# Example: libsql://your-db-name.turso.io
DATABASE_URL=
# Example: eyJhbG...
TURSO_DATABASE_TOKEN=

# Better Auth Secret & Base URL (Required for production authentication)
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Example: https://api-lifeos.shatik.me or https://your-domain.vercel.app
BETTER_AUTH_URL=

# CORS Allowed Origins (Comma-separated)
# Example: https://lifeos.shatik.me,https://your-domain.vercel.app,tauri://localhost
ALLOWED_ORIGINS=

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Timezone offset in minutes from UTC (default: 360 = UTC+6 Asia/Dhaka)
# Common values: 0 (UTC), 330 (IST), 360 (BST), -300 (EST), -480 (PST)
# TIMEZONE_OFFSET_MINUTES=360

