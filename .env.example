# LifeOS Environment Configuration

# Backend API server port
BACKEND_PORT=3000

# Frontend Vite dev server port
FRONTEND_PORT=5173

# SQLite database file path (relative to backend directory or absolute)
DATABASE_PATH=./data/lifeos.sqlite

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Timezone offset in minutes from UTC (default: 360 = UTC+6 Asia/Dhaka)
# Common values: 0 (UTC), 330 (IST), 360 (BST), -300 (EST), -480 (PST)
# TIMEZONE_OFFSET_MINUTES=360
