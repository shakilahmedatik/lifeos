{
  "name": "@lifeos/contracts",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./date-utils": {
      "types": "./src/date-utils.ts",
      "import": "./src/date-utils.ts",
      "require": "./src/date-utils.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "import": "./src/schemas.ts",
      "require": "./src/schemas.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
